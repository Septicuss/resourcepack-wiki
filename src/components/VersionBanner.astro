---
import wikiConfig from "../../content/config.ts";
import Icon from "@/Icon.astro";
import {getPage} from "../lib/pages.ts";

const { id } = Astro.params;

const page = id ? await getPage(id) : undefined;
const pageVersion = page?.data.version
const wikiVersion = wikiConfig.version

const versionMatches = (pageVersion == undefined || wikiVersion === pageVersion)
---

{pageVersion && <>
    <div class={`banner ${!versionMatches && 'mismatch'}`}>

        {versionMatches ?
                <>
                    <Icon name="success" />
                    <span>This page has been verified with the latest version <span class="version">{wikiConfig.version}</span>!</span>
                </>:
                <>
                    <Icon name="error" />
                    <span>This page has not yet been verified with the latest version <span class="version">{wikiConfig.version}</span></span>
                </>}
    </div>
</>}


<style>
    .banner {
        display: flex;
        gap: 0.3rem;
        border: 3px solid var(--border);
        border-radius: 1rem;
        padding: 0.5rem;
        margin: 1rem 0 1rem 0;
    }

    .banner.mismatch {
        color: #ff0000;

        .icon {
            color: red;
        }

        .version {
            color: red;
        }
    }

    .version {
        color: var(--accent);
        font-weight: bold;
    }
</style>