---


---
<main class="prose">
    <slot />
</main>

<style>
    .prose {
        width: 100%;
        margin: 0 auto;
        color: var(--text);
    }

    .prose :global(h1) {
        font-size: 2em;
        font-weight: 700;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
        color: var(--accent);
    }

    .prose :global(h2) {
        font-size: 1.5em;
        font-weight: 600;
        margin-top: 32px;
        margin-bottom: 12px;
        color: var(--accent);
    }

    .prose :global(h3) {
        font-size: 1.25em;
        font-weight: 600;
        margin-top: 24px;
        margin-bottom: 8px;
    }

    .prose :global(p) {
        line-height: 1.7;
        margin-bottom: 16px;
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin-bottom: 16px;
        padding-left: 24px;
    }

    .prose :global(li) {
        line-height: 1.7;
        margin-bottom: 4px;
    }

    .prose :global(code) {
        background: var(--hover);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9em;
    }

    .prose :global(pre) {
        background: var(--hover);
        padding: 16px;
        border-radius: 8px;
        overflow-x: scroll;
        margin-bottom: 16px;
    }

    .prose :global(pre code) {
        background: none;
        padding: 0;
    }

    .prose :global(blockquote) {
        border-left: 3px solid var(--accent);
        padding-left: 16px;
        margin-bottom: 16px;
        color: var(--textSecondary);
    }

    .prose :global(a) {
        color: var(--accent);
        text-decoration: none;
    }

    .prose :global(a:hover) {
        text-decoration: underline;
    }

    .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 16px;
    }

    .prose :global(th),
    .prose :global(td) {
        border: 1px solid var(--border);
        padding: 8px 12px;
        text-align: left;
    }

    .prose :global(th) {
        background: var(--hover);
        font-weight: 600;
    }

    .prose :global(hr) {
        border: none;
        border-top: 1px solid var(--border);
        margin: 24px 0;
    }


</style>